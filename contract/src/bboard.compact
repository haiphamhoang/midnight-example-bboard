pragma language_version 0.21;

import CompactStandardLibrary;

export enum State {
  OPEN,
  CLOSED,
}

export struct Message {
  id: Uint<64>,
  content: Maybe<Opaque<"string">>,
  owner: Bytes<32>
}

export ledger messageMap: Map<Uint<64>, Message>;

export ledger state: State;

export ledger sequence: Counter;

export sealed ledger maxMessages: Uint<32>;

constructor() {
  state = State.OPEN;
  maxMessages = 10;
  messageMap.resetToDefault();
  sequence.increment(1);
}

witness localSecretKey(): Bytes<32>;

export circuit post(newMessage: Opaque<"string">): [] {
  assert(state == State.OPEN, "Attempted to post to an closed board");
  messageMap.insert(
    sequence,
    Message { 
      id: disclose(sequence), 
      content: disclose(some<Opaque<"string">>(newMessage)),
      owner: disclose(publicKey(localSecretKey(), sequence as Field as Bytes<32>))
    }
  );
  sequence.increment(1);

  // Close the board when message limit is reached
  if (messageMap.size() >= maxMessages) {
    state = State.CLOSED;
  }
}


export circuit takeDown(messageId: Uint<64>): Opaque<"string"> {
  assert(messageMap.member(disclose(messageId)), "Message id not found");
  const message = messageMap.lookup(disclose(messageId)) as Message;
  const formerMsg = message.content.value;

  assert(message.owner == publicKey(localSecretKey(), messageId as Field as Bytes<32>), "Attempted to take down message, but not the current owner");
  messageMap.remove(disclose(messageId));

  if (state == State.CLOSED && messageMap.size() < maxMessages) {
    state = State.OPEN;
  }

  return formerMsg;
}

export circuit publicKey(sk: Bytes<32>, sequence: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "bboard:pk:"), sequence, sk]);
}
