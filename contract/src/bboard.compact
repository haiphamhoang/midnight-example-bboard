pragma language_version 0.21;

import CompactStandardLibrary;

export enum State {
  OPEN,
  CLOSED,
}

export struct Message {
  id: Uint<64>,
  content: Maybe<Opaque<"string">>,
  expiryTimestamp: Uint<64>
}

export ledger state: State;

export ledger messageMap: Map<Uint<64>, Message>;

ledger messageOwner: Map<Uint<64>, Bytes<32>>;

export ledger sequence: Counter;

export sealed ledger MAX_TOTAL_MESSAGES: Uint<32>;

export sealed ledger MAX_EXPIRATION_SECONDS: Uint<64>;


constructor() {
  state = State.OPEN;
  MAX_TOTAL_MESSAGES = 10;
  MAX_EXPIRATION_SECONDS = 86400; // 24 hours in seconds
  messageMap.resetToDefault();
  sequence.increment(1);
}

witness localSecretKey(): Bytes<32>;

export circuit post(newMessage: Opaque<"string">, expiryTimestamp: Uint<64>): [] {
  assert(
    state == State.OPEN, 
    "Attempted to post message, but board is closed"
  );
  assert(
    kernel.blockTimeGreaterThan(disclose(expiryTimestamp - MAX_EXPIRATION_SECONDS)), 
    "Expiry Timestamp must be within 24 hours from current block time"
  );
  messageMap.insert(
    sequence,
    Message { 
      id: disclose(sequence), 
      content: disclose(some<Opaque<"string">>(newMessage)),
      expiryTimestamp: disclose(expiryTimestamp)
    }
  );
  messageOwner.insert(
    sequence,
    disclose(publicKey(localSecretKey(), sequence as Field as Bytes<32>))
  );
  sequence.increment(1);

  // Close the board when message limit is reached
  if (messageMap.size() >= MAX_TOTAL_MESSAGES) {
    state = State.CLOSED;
  }
}

export circuit takeDown(messageId: Uint<64>): Opaque<"string"> {
  assert(messageMap.member(disclose(messageId)), "Message does not exist");
  const message = messageMap.lookup(disclose(messageId)) as Message;
  const formerMsg = message.content.value;
  const owner = messageOwner.lookup(disclose(messageId)) as Bytes<32>;

  assert(
    owner == disclose(publicKey(localSecretKey(), messageId as Field as Bytes<32>)) || 
    kernel.blockTimeGreaterThan(message.expiryTimestamp), 
    "Attempted to take down message, but not the current owner or message has not expired"
  );
  messageMap.remove(disclose(messageId));
  messageOwner.remove(disclose(messageId));

  if (state == State.CLOSED && messageMap.size() < MAX_TOTAL_MESSAGES) {
    state = State.OPEN;
  }

  return formerMsg;
}

export circuit provingOwnership(messageId: Uint<64>): Boolean {
  assert(messageOwner.member(disclose(messageId)), "Message does not exist");
  const owner = messageOwner.lookup(disclose(messageId)) as Bytes<32>;

  return owner == disclose(publicKey(localSecretKey(), messageId as Field as Bytes<32>));
}

export pure circuit publicKey(sk: Bytes<32>, sequence: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "bboard:pk:"), sequence, sk]);
}
